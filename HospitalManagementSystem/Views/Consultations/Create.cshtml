@model Consultation
@{ ViewData["Title"] = "New consultation"; var visit = (Visit)ViewBag.Visit; }
<h1>Consultation — @visit.Patient.FullName</h1>
<p class="text-muted">Vitals: @visit.Triage?.Vitals</p>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="VisitId" />
    <div class="mb-3">
        <label class="form-label">Diagnosis</label>
        <textarea asp-for="Diagnosis" class="form-control" required></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save consultation</button>
</form>
