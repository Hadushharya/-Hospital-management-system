@model List<Visit>
@{
    ViewData["Title"] = "OPD queue"; ViewBag.SidebarRole = "OPD"; Layout = "_DashboardLayout";
}
<h1>OPD queue</h1>
<table class="table">
    <thead><tr><th>Patient</th><th>Vitals</th><th></th></tr></thead>
    <tbody>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.Patient.FullName</td>
            <td>@v.Triage?.Vitals</td>
            <td><a class="btn btn-sm btn-primary" asp-action="Create" asp-route-visitId="@v.Id">Start consultation</a></td>
        </tr>
    }
    </tbody>
</table>
