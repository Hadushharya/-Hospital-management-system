@model Consultation
@{
    ViewData["Title"] = "Manage consultation";
    var medicines = (List<Medicine>)ViewBag.Medicines;
    var labFees = (List<FeeSetting>)ViewBag.LabFees;
}
<h1>@Model.Visit.Patient.FullName</h1>
<p><strong>Diagnosis:</strong> @Model.Diagnosis</p>

<div class="row">
    <div class="col-md-6">
        <h4>Lab requests</h4>
        <ul class="list-group mb-3">
            @foreach (var lr in Model.LabRequests)
            {
                <li class="list-group-item">
                    <div class="d-flex justify-content-between">
                        @lr.TestName <span class="badge bg-info">@lr.Status</span>
                    </div>

                    @if (lr.Status == LabRequestStatus.Completed && lr.LabResult != null)
                    {
                        <div class="mt-2 p-2 bg-light border rounded">
                            <div><strong>Result:</strong> @lr.LabResult.ResultValue</div>
                            @if (!string.IsNullOrWhiteSpace(lr.LabResult.Notes))
                            {
                                <div><strong>Notes:</strong> @lr.LabResult.Notes</div>
                            }
                            <div class="text-muted small">
                                Sent @lr.SentAt?.ToLocalTime().ToString("g")
                            </div>
                        </div>
                    }
                    else if (lr.Status == LabRequestStatus.ResultEntered)
                    {
                        <div class="mt-2 text-muted small">
                            Result entered by the lab — waiting for it to be sent over.
                        </div>
                    }
                </li>
            }
        </ul>
        @if (labFees.Count == 0)
        {
            <div class="alert alert-warning small">
                No active Lab fees configured. Ask an Admin to add one under
                <a asp-controller="FeeSettings" asp-action="Create">Fee settings</a>.
            </div>
        }
        else
        {
            <form asp-action="RequestLab" method="post" class="border p-3">
                <input type="hidden" name="consultationId" value="@Model.Id" />
                <div id="labRows">
                    <div class="row g-2 mb-2 lab-row">
                        <div class="col-6">
                            <input name="testNames" class="form-control form-control-sm" placeholder="Test name" required />
                        </div>
                        <div class="col-6">
                            <select name="feeSettingIds" class="form-select form-select-sm" required>
                                <option value="">-- lab fee --</option>
                                @foreach (var f in labFees)
                                {
                                    <option value="@f.Id">@f.PaymentName — @f.Amount</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mb-2" onclick="addLabRow()">+ Add another test</button>
                <br />
                <button class="btn btn-outline-primary btn-sm" type="submit">
                    Send to Reception + Lab
                </button>
            </form>
            <script>
                        function addLabRow() {
                            var container = document.getElementById('labRows');
                            var row = container.querySelector('.lab-row').cloneNode(true);
                            row.querySelectorAll('select, input').forEach(el => el.value = '');
                            container.appendChild(row);
                        }
            </script>
        }
    </div>

    <div class="col-md-6">
        <h4>Prescriptions</h4>
        @foreach (var p in Model.Prescriptions)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <span class="badge bg-secondary">@p.Status</span>
                    <ul>
                        @foreach (var item in p.PrescriptionItems)
                        {
                            <li>@item.Medicine.Name x @item.Quantity</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (medicines.Count == 0)
        {
            <div class="alert alert-warning small">No medicines in stock yet.</div>
        }
        else
        {
            <form asp-action="Prescribe" method="post" class="border p-3" id="prescribeForm">
                <input type="hidden" name="consultationId" value="@Model.Id" />
                <div id="prescriptionRows">
                    <div class="row g-2 mb-2 prescription-row">
                        <div class="col-7">
                            <select name="medicineIds" class="form-select form-select-sm" required>
                                <option value="">-- medicine --</option>
                                @foreach (var m in medicines)
                                {
                                    <option value="@m.Id">@m.Name (@m.QuantityInStock in stock)</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <input name="quantities" type="number" min="1" class="form-control form-control-sm" placeholder="qty" required />
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary mb-2" onclick="addRow()">+ Add another item</button>
                <br />
                <button type="submit" class="btn btn-outline-primary btn-sm">Send prescription to Cashier/Pharmacy</button>
            </form>
            <script>
                        function addRow() {
                            var container = document.getElementById('prescriptionRows');
                            var row = container.querySelector('.prescription-row').cloneNode(true);
                            row.querySelectorAll('select, input').forEach(el => el.value = '');
                            container.appendChild(row);
                        }
            </script>
        }
    </div>
</div>
<a class="btn btn-secondary mt-3" asp-action="Index">Back to queue</a>