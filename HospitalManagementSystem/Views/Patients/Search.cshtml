@model List<Patient>
@{
    ViewData["Title"] = "Search patients";
    ViewBag.SidebarRole = "Reception";
    Layout = "_DashboardLayout";
    var lastVisits = (Dictionary<int, DateTime>)ViewBag.LastVisits;
}
<h1 class="mb-3">Search patients</h1>
<form method="get" class="d-flex gap-2 mb-4" style="max-width:400px">
    <input type="text" name="q" class="form-control" placeholder="Name or phone..." value="@ViewBag.Query" />
    <button class="btn btn-primary" type="submit">Search</button>
</form>

@if (ViewBag.Query != null && !Model.Any())
{
    <p class="text-muted">No patients found.</p>
}

@foreach (var p in Model)
{
    var hasLastVisit = lastVisits.TryGetValue(p.Id, out var lastVisitDate);
    var daysSince = hasLastVisit ? (DateTime.UtcNow - lastVisitDate).TotalDays : (double?)null;
    var withinWindow = daysSince.HasValue && daysSince <= 5;

    <div class="card mb-2">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <strong>@p.FullName</strong>  -@p.Phone
                <div class="text-muted small">
                    @(hasLastVisit ? $"Last visit: {lastVisitDate.ToLocalTime():dd MMM yyyy} ({(int)daysSince!.Value} day(s) ago)" : "No previous visits")
                </div>
            </div>
            <div>
                @if (withinWindow)
                {
                    <form asp-action="SendToTriageFree" method="post" class="d-inline">
                        <input type="hidden" name="patientId" value="@p.Id" />
                        <button class="btn btn-success btn-sm" type="submit">Send to Triage (no payment)</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-warning btn-sm" asp-action="Revisit" asp-route-patientId="@p.Id">
                        New visit — payment required
                    </a>
                }
            </div>
        </div>
    </div>
}