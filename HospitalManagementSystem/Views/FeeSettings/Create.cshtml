@model FeeSetting
@{ ViewData["Title"] = "Add fee setting"; }
<h1>Add fee setting</h1>
<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Payment name</label>
        <input asp-for="PaymentName" class="form-control" placeholder="e.g. Registration Card Fee" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Fee type</label>
        <select asp-for="FeeType" class="form-select">
            <option value="@((int)FeeType.Registration)">Registration</option>
            <option value="@((int)FeeType.Consultation)">Consultation</option>
            <option value="@((int)FeeType.Lab)">Lab</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Amount</label>
        <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
