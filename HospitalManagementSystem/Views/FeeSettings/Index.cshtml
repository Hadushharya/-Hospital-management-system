@model List<FeeSetting>
@{ ViewData["Title"] = "Fee settings"; }
<h1>Fee settings</h1>
<p class="text-muted">Reception and OPD pick from this list — amounts aren't typed by hand.</p>
<a class="btn btn-primary mb-3" asp-action="Create">Add fee</a>
<table class="table table-striped">
    <thead><tr><th>Order #</th><th>Name</th><th>Type</th><th>Amount</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.Id</td>
            <td>@f.PaymentName</td>
            <td>@f.FeeType</td>
            <td>@f.Amount</td>
            <td>@(f.IsActive ? "Active" : "Inactive")</td>
            <td>
                <form asp-action="ToggleActive" asp-route-id="@f.Id" method="post">
                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                        @(f.IsActive ? "Deactivate" : "Activate")
                    </button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
