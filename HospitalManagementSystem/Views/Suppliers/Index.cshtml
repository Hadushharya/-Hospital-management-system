@model List<Supplier>
@{ ViewData["Title"] = "Suppliers"; }
<h1>Suppliers</h1>
<a class="btn btn-primary mb-3" asp-action="Create">Add supplier</a>
<table class="table">
    <thead><tr><th>Name</th><th>Contact</th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr><td>@s.Name</td><td>@s.Contact</td></tr>
    }
    </tbody>
</table>
