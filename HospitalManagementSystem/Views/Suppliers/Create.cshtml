@model Supplier
@{ ViewData["Title"] = "Add supplier"; }
<h1>Add supplier</h1>
<form asp-action="Create" method="post">
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Contact</label><input asp-for="Contact" class="form-control" required /></div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
