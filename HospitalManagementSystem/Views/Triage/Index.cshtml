@model List<Visit>
@{
    ViewData["Title"] = "Triage queue"; ViewBag.SidebarRole = "Triage"; Layout = "_DashboardLayout";
}
<h1>Triage queue</h1>
<table class="table">
    <thead><tr><th>Patient</th><th>Visit date</th><th></th></tr></thead>
    <tbody>
    @foreach (var v in Model)
    {
        <tr>
            <td>@v.Patient.FullName</td>
            <td>@v.VisitDate.ToLocalTime()</td>
            <td><a class="btn btn-sm btn-primary" asp-action="Record" asp-route-visitId="@v.Id">Record vitals</a></td>
        </tr>
    }
    </tbody>
</table>
