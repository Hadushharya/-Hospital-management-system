@model List<LabRequest>
@{
    ViewData["Title"] = "Lab queue"; ViewBag.SidebarRole = "Lab"; Layout = "_DashboardLayout";
}
<h1>Paid test queue</h1>
<table class="table">
    <thead><tr><th>Patient</th><th>Test</th><th></th></tr></thead>
    <tbody>
    @foreach (var lr in Model)
    {
        <tr>
            <td>@lr.Consultation.Visit.Patient.FullName</td>
            <td>@lr.TestName</td>
            <td><a class="btn btn-sm btn-primary" asp-action="EnterResult" asp-route-id="@lr.Id">Enter result</a></td>
        </tr>
    }
    </tbody>
</table>
