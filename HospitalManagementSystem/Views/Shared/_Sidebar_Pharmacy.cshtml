@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string, string> active = (c, a) =>
        (controller == c && action == a) ? "active" : "";
}
<ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link @active("Dashboard", "Pharmacy")" asp-controller="Dashboard" asp-action="Pharmacy">
            Dashboard
        </a>
    </li>
</ul>
<div class="section-label">Dispensing</div>
<ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link @active("Pharmacy", "ReadyToDispense")" asp-controller="Pharmacy" asp-action="ReadyToDispense">
            Ready to dispense
        </a>
    </li>
</ul>