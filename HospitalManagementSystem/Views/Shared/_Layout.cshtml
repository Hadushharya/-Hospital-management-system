<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">HMS</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole(StaffRoles.Receptionist) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Patients" asp-action="Index">Reception</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Invoices" asp-action="Pending">Billing queue</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.TriageNurse) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Triage" asp-action="Index">Triage</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.OpdRolesCsv) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Consultations" asp-action="Index">OPD</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.LabTechnician) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="LabRequests" asp-action="Queue">Lab</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.StoreMan) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Medicines" asp-action="Index">Medicines</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="MedicalGoods" asp-action="Index">Medical goods</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index">Suppliers</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.Cashier) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Pharmacy" asp-action="PendingPayments">Cashier</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.Pharmacist) || User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Pharmacy" asp-action="ReadyToDispense">Pharmacy</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="FeeSettings" asp-action="Index">Fee settings</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Users</a></li>
                        }
                        @if (User.IsInRole(StaffRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Admin">Admin</a></li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Consultations" asp-action="ResultsQueue">
                                New Results
                                @* optional badge — needs a small controller/viewbag addition if you want a live count *@
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-light">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form class="d-flex" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
                            <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning">@TempData["Warning"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
