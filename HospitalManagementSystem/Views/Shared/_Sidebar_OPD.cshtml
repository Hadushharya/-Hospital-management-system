@using HospitalManagementSystem.Data
@using HospitalManagementSystem.Models
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    Func<string, string, string> active = (c, a) =>
        (controller == c && action == a) ? "active" : "";

    var isAdmin = User.IsInRole(StaffRoles.Admin);
    var doctorId = isAdmin ? null : UserManager.GetUserId(User);

    var newResultsQuery = Db.Consultations.Where(c => c.HasNewLabResult);
    if (doctorId != null)
        newResultsQuery = newResultsQuery.Where(c => c.DoctorId == doctorId);
    var newResultsCount = await newResultsQuery.CountAsync();
}
<ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link @active("Dashboard", "OPD")" asp-controller="Dashboard" asp-action="OPD">
            Dashboard
        </a>
    </li>
</ul>
<div class="section-label">Consultations</div>
<ul class="nav flex-column">
    <li class="nav-item">
        <a class="nav-link @active("Consultations", "Index")" asp-controller="Consultations" asp-action="Index">
            Consultation queue
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link d-flex justify-content-between align-items-center @active("Consultations", "ResultsQueue")"
           asp-controller="Consultations" asp-action="ResultsQueue">
            New results
            @if (newResultsCount > 0)
            {
                <span class="badge bg-danger rounded-pill">@newResultsCount</span>
            }
        </a>
    </li>
</ul>
<div class="section-label">Patient history</div>
<div class="px-3">
    <form asp-controller="Consultations" asp-action="History" method="get" class="mb-2">
        <input type="text" name="q" class="form-control form-control-sm" placeholder="Name or phone..." />
    </form>
    <a class="small" asp-controller="Consultations" asp-action="History">Browse all history &raquo;</a>
</div>