<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: #f4f5f7;
            }

            .hms-sidebar {
                width: 230px;
                min-height: 100vh;
                background: #1a1d23;
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
            }

                .hms-sidebar .brand {
                    color: #fff;
                    font-weight: 700;
                    font-size: 1.25rem;
                    padding: 1rem 1.25rem;
                    display: block;
                }

                .hms-sidebar a.nav-link {
                    color: #b7bcc7;
                    padding: 0.6rem 1.25rem;
                    border-left: 3px solid transparent;
                }

                    .hms-sidebar a.nav-link:hover {
                        color: #fff;
                        background: #23262d;
                    }

                    .hms-sidebar a.nav-link.active {
                        color: #fff;
                        background: #23262d;
                        border-left-color: #0d6efd;
                    }

                .hms-sidebar .section-label {
                    color: #6b7280;
                    text-transform: uppercase;
                    font-size: 0.7rem;
                    padding: 1rem 1.25rem 0.25rem;
                    letter-spacing: .05em;
                }

            .hms-content {
                margin-left: 230px;
            }

            .hms-topbar {
                background: #fff;
                border-bottom: 1px solid #e5e7eb;
                padding: 0.75rem 1.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .hms-main {
                padding: 1.5rem;
            }
    </style>
</head>
<body>
    <nav class="hms-sidebar d-flex flex-column">
        <a class="brand" asp-controller="Home" asp-action="Index">HMS</a>
        @{
            string sidebarRole = ViewBag.SidebarRole ?? "Default";
            string sidebarPartial = "_Sidebar_" + sidebarRole;
        }
        @await Html.PartialAsync(sidebarPartial)
    </nav>

    <div class="hms-content">
        <div class="hms-topbar">
            <h5 class="mb-0">@ViewData["Title"]</h5>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">@User.Identity!.Name</span>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Log out</button>
                </form>
            </div>
        </div>
        <div class="hms-main">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning">@TempData["Warning"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>