@{
    ViewData["Title"] = "General report";
    ViewBag.SidebarRole = "Admin";
    Layout = "_DashboardLayout";
    var start = (DateTime)ViewBag.Start;
    var end = (DateTime)ViewBag.End;
    var invoicesByType = (IEnumerable<dynamic>)ViewBag.InvoicesByType;
}
<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <form method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label small mb-0">Start date</label>
            <input type="date" name="start" class="form-control" value="@start.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label class="form-label small mb-0">End date</label>
            <input type="date" name="end" class="form-control" value="@end.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">View</button>
    </form>
    <button class="btn btn-outline-secondary" onclick="window.print()">Print report</button>
</div>

<!-- On-screen dashboard view — hidden entirely when printing -->
<div class="no-print">
    <h3 class="mb-1">General Report</h3>
    <p class="text-muted">
        @(start == end ? start.ToString("dddd, dd MMMM yyyy") : $"{start:dd MMM yyyy} — {end:dd MMM yyyy}")
    </p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Patients registered</div>
                    <div class="fs-4 fw-bold">@ViewBag.PatientsRegistered</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Visits</div>
                    <div class="fs-4 fw-bold">@ViewBag.VisitsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Service revenue</div>
                    <div class="fs-4 fw-bold">@(((decimal)ViewBag.InvoiceTotal).ToString("0.00"))</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Product revenue</div>
                    <div class="fs-4 fw-bold">@(((decimal)ViewBag.PaymentTotal).ToString("0.00"))</div>
                </div>
            </div>
        </div>
    </div>

    <h5>Service fees (Reception / OPD)</h5>
    <table class="table table-sm">
        <thead><tr><th>Fee type</th><th>Count</th><th class="text-end">Total</th></tr></thead>
        <tbody>
            @foreach (var row in invoicesByType)
            {
                decimal rowTotal = row.Total;
                <tr>
                    <td>@row.FeeType</td>
                    <td>@row.Count</td>
                    <td class="text-end">@rowTotal.ToString("0.00")</td>
                </tr>
            }
            @if (!invoicesByType.Any())
            {
                <tr><td colspan="3" class="text-muted">No service fees collected in this range.</td></tr>
            }
        </tbody>
    </table>

    <h5 class="mt-4">Product fees (Cashier / Pharmacy)</h5>
    <table class="table table-sm">
        <tbody>
            <tr>
                <td>Medicine/goods payments</td>
                <td>@ViewBag.PaymentCount</td>
                <td class="text-end">@(((decimal)ViewBag.PaymentTotal).ToString("0.00"))</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Formal printable summary — only this shows up on paper -->
<div id="printArea" class="d-none">
    <div class="text-center mb-4">
        <h4 class="mb-0">Golden Maternal And Child Health Care Center</h4>
        <div>Shire Indaslassie</div>
        <div>Tel: 09-14-55-19-27</div>
        <hr />
        <div class="fw-bold" style="text-decoration: underline;">GENERAL REPORT</div>
        <div class="text-muted small">
            @(start == end ? start.ToString("dddd, dd MMMM yyyy") : $"{start:dd MMM yyyy} — {end:dd MMM yyyy}")
        </div>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th style="width:60px">S/N</th>
                <th>Services</th>
                <th class="text-end" style="width:150px">Price</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sn = 1;
            }
            @foreach (var row in invoicesByType)
            {
                decimal rowTotal = row.Total;
                <tr>
                    <td>@sn</td>
                    <td>@row.FeeType</td>
                    <td class="text-end">@rowTotal.ToString("0.00")</td>
                </tr>
                sn++;
            }
            <tr>
                <td>@sn</td>
                <td>Medicine / Goods (Pharmacy)</td>
                <td class="text-end">@(((decimal)ViewBag.PaymentTotal).ToString("0.00"))</td>
            </tr>
        </tbody>
        <tfoot>
            <tr class="fw-bold fs-5">
                <td colspan="2">GRAND TOTAL</td>
                <td class="text-end">@(((decimal)ViewBag.GrandTotal).ToString("0.00"))</td>
            </tr>
        </tfoot>
    </table>

    <div class="mt-5 pt-5 d-flex justify-content-between">
        <div>Prepared by: ____________________</div>
        <div>Signature: ____________________</div>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        .hms-sidebar, .hms-topbar {
            display: none !important;
        }

        .hms-content {
            margin-left: 0 !important;
        }

        #printArea {
            display: block !important;
        }

        body {
            font-family: 'Times New Roman', serif;
        }
    }
</style>