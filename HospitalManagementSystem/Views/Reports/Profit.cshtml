@{
    ViewData["Title"] = "Profit report";
    ViewBag.SidebarRole = "Admin";
    Layout = "_DashboardLayout";
    var start = (DateTime)ViewBag.Start;
    var end = (DateTime)ViewBag.End;
    var rows = (IEnumerable<dynamic>)ViewBag.Rows;
}
<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <form method="get" class="d-flex gap-2 align-items-end">
        <div>
            <label class="form-label small mb-0">Start date</label>
            <input type="date" name="start" class="form-control" value="@start.ToString("yyyy-MM-dd")" />
        </div>
        <div>
            <label class="form-label small mb-0">End date</label>
            <input type="date" name="end" class="form-control" value="@end.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">View</button>
    </form>
    <button class="btn btn-outline-secondary" onclick="window.print()">Print report</button>
</div>

<!-- On-screen dashboard view — hidden entirely when printing -->
<div class="no-print">
    <h3 class="mb-1">Profit Report</h3>
    <p class="text-muted">@start.ToString("dd MMM yyyy") — @end.ToString("dd MMM yyyy")</p>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Total cost (Store Man)</div>
                    <div class="fs-4 fw-bold">@(((decimal)ViewBag.TotalCost).ToString("0.00"))</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Total revenue (catalog price)</div>
                    <div class="fs-4 fw-bold">@(((decimal)ViewBag.TotalRevenue).ToString("0.00"))</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted small">Total profit</div>
                    <div class="fs-4 fw-bold @(((decimal)ViewBag.TotalProfit) >= 0 ? "text-success" : "text-danger")">
                        @(((decimal)ViewBag.TotalProfit).ToString("0.00"))
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info small">
        Actual cash collected by Cashier in this range: <strong>@(((decimal)ViewBag.ActualCollected).ToString("0.00"))</strong>
        — may differ from catalog revenue above if a cashier entered a custom amount
        or a prescription was notes-only (no itemized medicine).
    </div>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Medicine</th>
                <th class="text-end">Qty dispensed</th>
                <th class="text-end">Cost price</th>
                <th class="text-end">Selling price</th>
                <th class="text-end">Total cost</th>
                <th class="text-end">Total revenue</th>
                <th class="text-end">Profit</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in rows)
            {
                decimal costPrice = r.CostPrice;
                decimal sellingPrice = r.SellingPrice;
                decimal totalCost = r.TotalCost;
                decimal totalRevenue = r.TotalRevenue;
                decimal profit = r.Profit;
                <tr>
                    <td>@r.MedicineName</td>
                    <td class="text-end">@r.QuantityDispensed</td>
                    <td class="text-end">@costPrice.ToString("0.00")</td>
                    <td class="text-end">@sellingPrice.ToString("0.00")</td>
                    <td class="text-end">@totalCost.ToString("0.00")</td>
                    <td class="text-end">@totalRevenue.ToString("0.00")</td>
                    <td class="text-end @(profit >= 0 ? "text-success" : "text-danger")">
                        @profit.ToString("0.00")
                    </td>
                </tr>
            }
            @if (!rows.Any())
            {
                <tr><td colspan="7" class="text-muted">Nothing dispensed in this range.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Formal printable summary — only this shows up on paper -->
<div id="printArea" class="d-none">
    <div class="text-center mb-4">
        <h4 class="mb-0">Golden Maternal And Child Health Care Center</h4>
        <div>Shire Endaslassie</div>
        <div>Tel: 09-14-55-19-27</div>
        <hr />
        <div class="fw-bold" style="text-decoration: underline;">PROFIT REPORT</div>
        <div class="text-muted small">@start.ToString("dd MMM yyyy") — @end.ToString("dd MMM yyyy")</div>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th style="width:60px">S/N</th>
                <th>Medicine</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Cost price</th>
                <th class="text-end">Selling price</th>
                <th class="text-end">Total cost</th>
                <th class="text-end">Total revenue</th>
                <th class="text-end">Profit</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sn = 1;
            }
            @foreach (var r in rows)
            {
                decimal costPrice = r.CostPrice;
                decimal sellingPrice = r.SellingPrice;
                decimal totalCost = r.TotalCost;
                decimal totalRevenue = r.TotalRevenue;
                decimal profit = r.Profit;
                <tr>
                    <td>@sn</td>
                    <td>@r.MedicineName</td>
                    <td class="text-end">@r.QuantityDispensed</td>
                    <td class="text-end">@costPrice.ToString("0.00")</td>
                    <td class="text-end">@sellingPrice.ToString("0.00")</td>
                    <td class="text-end">@totalCost.ToString("0.00")</td>
                    <td class="text-end">@totalRevenue.ToString("0.00")</td>
                    <td class="text-end">@profit.ToString("0.00")</td>
                </tr>
                sn++;
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold fs-5">
                <td colspan="5">GRAND TOTAL</td>
                <td class="text-end">@(((decimal)ViewBag.TotalCost).ToString("0.00"))</td>
                <td class="text-end">@(((decimal)ViewBag.TotalRevenue).ToString("0.00"))</td>
                <td class="text-end">@(((decimal)ViewBag.TotalProfit).ToString("0.00"))</td>
            </tr>
        </tfoot>
    </table>

    <div class="mt-5 pt-5 d-flex justify-content-between">
        <div>Prepared by: ____________________</div>
        <div>Signature: ____________________</div>
    </div>
</div>

<style>
    @@media print {
        .no-print {
            display: none !important;
        }

        .hms-sidebar, .hms-topbar {
            display: none !important;
        }

        .hms-content {
            margin-left: 0 !important;
        }

        #printArea {
            display: block !important;
        }

        body {
            font-family: 'Times New Roman', serif;
        }
    }
</style>