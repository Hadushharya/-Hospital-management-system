@using HospitalManagementSystem.Models
@{
    ViewData["Title"] = "Pharmacy dashboard";
    ViewBag.SidebarRole = "Pharmacy";
    Layout = "_DashboardLayout";
}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Ready to dispense</div>
                <div class="fs-3 fw-bold">@ViewBag.ReadyToDispenseCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Dispensed total</div>
                <div class="fs-3 fw-bold">@ViewBag.DispensedToday</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <div class="text-muted small">Low stock items</div>
                <div class="fs-3 fw-bold">@ViewBag.LowStockCount</div>
            </div>
        </div>
    </div>
</div>

<div class="mb-4">
    <a class="btn btn-primary" asp-controller="Pharmacy" asp-action="ReadyToDispense">Go to ready-to-dispense</a>
</div>

<div class="card">
    <div class="card-header">Next up</div>
    <table class="table mb-0">
        <thead><tr><th>Patient</th><th>Items</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in (List<Prescription>)ViewBag.RecentQueue)
            {
                <tr>
                    <td>@p.Consultation.Visit.Patient.FullName</td>
                    <td>
                        @string.Join(", ", p.PrescriptionItems.Select(i => $"{i.Medicine.Name} x{i.Quantity}"))
                        @if (!p.PrescriptionItems.Any() && !string.IsNullOrWhiteSpace(p.Notes))
                        {
                            <span class="fst-italic">@p.Notes</span>
                        }
                    </td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
</div>